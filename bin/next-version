#!/usr/bin/env bash
# Berechnet die nächste Version aus der aktuellen und den Labels eines Pull Requests.
#
#   bin/next-version <Version> [<Labels>]
#
# <Version> hat die Form MAJOR.MINOR.PATCH. <Labels> ist eine Liste der Labels des Pull Requests, durch Komma
# getrennt. Das Label "major" hebt die erste Stelle an und setzt die beiden anderen auf 0, "minor" hebt die zweite an
# und setzt die dritte auf 0, "patch" hebt die dritte an. Trägt der Pull Request mehrere dieser Labels, gilt das
# höchste. Ohne eines dieser Labels gilt "patch".
#
# Der Ablauf steht in .github/workflows/release.yml, die Beschreibung in der README (Abschnitt "Releases"),
# der Test in tests/versioning.sh. Das Skript gehört zur CI und wird weder installiert noch ins Image kopiert.
set -euo pipefail

version="${1:-}"
labels="${2:-}"

if [[ ! "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  echo "Die Version \"$version\" hat nicht die Form MAJOR.MINOR.PATCH, zum Beispiel 1.3.0. Bitte die Zeile VERSION=\"…\" in bin/oracle-sniper und das letzte Tag vX.Y.Z prüfen." >&2
  exit 1
fi
major="${BASH_REMATCH[1]}"
minor="${BASH_REMATCH[2]}"
patch="${BASH_REMATCH[3]}"

level="patch"
IFS=',' read -r -a names <<< "$labels"
for name in "${names[@]:-}"; do
  name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
  if [[ "$name" == "major" ]]; then
    level="major"
  elif [[ "$name" == "minor" && "$level" != "major" ]]; then
    level="minor"
  fi
done

case "$level" in
  major) printf '%d.0.0\n' $((10#$major + 1)) ;;
  minor) printf '%d.%d.0\n' "$((10#$major))" $((10#$minor + 1)) ;;
  *) printf '%d.%d.%d\n' "$((10#$major))" "$((10#$minor))" $((10#$patch + 1)) ;;
esac
