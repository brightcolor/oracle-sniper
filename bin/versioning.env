# Einstellungen für die Versionsvergabe der CI (bin/base-version, bin/write-version, .github/workflows/release.yml).
# Jeder Wert lässt sich über die gleichnamige Umgebungsvariable ändern, etwa als Repository-Variable der CI.
#
# VERSION_FILES              Dateien mit der Zeile VERSION="X.Y.Z", durch Leerzeichen getrennt. Die erste ist die
#                            Quelle der aktuellen Version, alle bekommen die neue Nummer.
# VERSION_PLACEHOLDER        Platzhalter in Texten, den die CI beim Merge durch die neue Nummer ersetzt.
# VERSION_PLACEHOLDER_FILES  Git-Pfadmuster der Texte, in denen der Platzhalter ersetzt wird, durch Leerzeichen getrennt.
# VERSION_TAG_PREFIX         Vorsilbe der Tags, aus 1.4.0 wird so das Tag v1.4.0.

VERSION_FILES="${VERSION_FILES:-bin/oracle-sniper install.sh}"
VERSION_PLACEHOLDER="${VERSION_PLACEHOLDER:-@@VERSION@@}"
VERSION_PLACEHOLDER_FILES="${VERSION_PLACEHOLDER_FILES:-*.md}"
VERSION_TAG_PREFIX="${VERSION_TAG_PREFIX:-v}"

if [ -z "${VERSION_FILES// /}" ]; then
  echo "Die Einstellung VERSION_FILES ist leer. Bitte mindestens eine Datei mit der Zeile VERSION=\"…\" eintragen, Vorgabe: bin/oracle-sniper install.sh." >&2
  exit 1
fi
if [ -z "$VERSION_PLACEHOLDER" ]; then
  echo "Die Einstellung VERSION_PLACEHOLDER ist leer. Bitte einen Platzhalter eintragen, Vorgabe: @@VERSION@@." >&2
  exit 1
fi
